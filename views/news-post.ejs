<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= newsPost.title %> | IRONHOOF News</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="admin-header">
    <%- include('partals/site-nav', { brand: 'IRONHOOF NEWS', showApply: true, canAccessAdminPanel, isReporter }) %>
  </header>

  <main class="wide-main">
    <section class="card">
      <p class="eyebrow"><%= newsPost.posted_role %> • <%= newsPost.posted_by %></p>
      <h1><%= newsPost.title %></h1>
      <p class="muted"><%= new Date(newsPost.created_at).toLocaleString() %></p>
      <p><%= newsPost.summary || 'No summary provided.' %></p>

      <div class="pdf-actions">
        <a class="button-link" href="<%= pdfUrl %>" target="_blank" rel="noreferrer">Open Full Size</a>
        <a class="button-link" href="<%= pdfUrl %>" download>Download PDF</a>
      </div>

      <iframe
        class="pdf-frame"
        src="<%= pdfUrl %>"
        title="<%= newsPost.title %> PDF"
      ></iframe>
    </section>
  </main>
</body>
</html>